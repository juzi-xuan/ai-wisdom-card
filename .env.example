# ==============================================================================
#                        AI 知识卡片 · 环境变量示例模板
# ==============================================================================
# 这个文件的作用：
#     告诉别人"如果要运行这个项目，需要在 .env 里填哪些变量"。
#     就像租房合同上的"入住须知"，告诉你需要自备哪些东西。
#
# 使用方法：
#     1. 复制这个文件并重命名为 .env（在项目根目录下）
#     2. 把下面的占位符换成你自己的真实值
#     3. .env 不会被上传到 GitHub（已经在 .gitignore 里忽略了）
#
# ⚠️ 重要安全提醒：
#     - 永远不要把真实的 .env 文件提交到 Git
#     - 如果 API Key 不小心泄露了，立即去平台吊销并重新生成
# ==============================================================================

# ---------- Dify API 配置 ----------

# Dify 应用的 API Key（在 Dify 平台 → 你的应用 → API 访问 页面获取）
# 格式通常是 app-xxxxxxxxxxxxxxxxxxxxxxxx
DIFY_API_KEY=app-你的API_KEY占位符

# Dify API 的基础地址（自部署填自己的域名，云版用官方地址）
DIFY_API_URL=https://api.dify.ai/v1

# 用户标识（用于区分不同用户，可以随便填一个字符串，比如用户名或邮箱）
DIFY_USER_ID=default_user

# 工作流输入变量的名字（在 Dify 工作流里定义的输入变量名，比如 "y" 或 "input"）
DIFY_INPUT_KEY=y
