# ==============================================================================
#                            AI 知识卡片 · Git 忽略清单
# ==============================================================================
# 这个文件的作用：告诉 Git "这些文件你别管，不要上传到远程仓库"
# 就像出门旅行前的"装箱清单"，明确告诉你哪些东西是私人用品、
# 临时物品、大体积无用物品，不要塞进拉杆箱里。
#
# 打个比方：
#   .gitignore = "旅行禁带清单"
#   - .env = 钱包里的银行卡密码纸（绝对不能带出去）
#   - cards.db = 写了一半的日记本（私人数据，不要带）
#   - assets/generated/*.png = 旅途中临时买的纪念品（占地方，不带）
#   - __pycache__/ = 身上的灰尘碎屑（自动生成，不用带）
#   - .venv/ = 家里一整个冰箱（太重，快递比随身带好）
# ==============================================================================

# ==============================================================================
# 1. 🔐 敏感配置 & 密钥
# ==============================================================================
# 👉 这里面有 API Key、数据库密码等，绝对不能上传到 GitHub！
.env
.env.*
# .env.example 是示例模板（只有占位符），可以上传，用来告诉别人需要哪些环境变量
!.env.example

# ==============================================================================
# 2. 💾 数据库文件（运行时生成的数据）
# ==============================================================================
# cards.db 是每次运行 app 时创建/修改的 SQLite 数据库文件，
# 里面保存的是"用户自己生成的卡片"，属于个人数据，不应该随代码同步
data/*.db
data/*.sqlite
data/*.sqlite3
*.db
*.sqlite
*.sqlite3

# ==============================================================================
# 3. 🖼️ 运行时生成的卡片图片
# ==============================================================================
# 每次"生成卡片"都会在 assets/generated/ 里保存一张 PNG，
# 这些属于运行产物，就像打印店里打印出来的照片——
# 我们只需要上传"打印模板"（源代码），不需要上传每次打印出来的照片
assets/generated/*
# 👉 但 .gitkeep 这个空文件占位符要保留，它是用来"让空目录被 Git 跟踪"的
!assets/generated/.gitkeep
# 用户上传并保存到背景库的图片也不建议提交（个人资产），如果想共用背景就注释下一行
assets/backgrounds/user_*
# 👆 命名规则：user_时间戳.后缀，凡是 user_ 开头的都是用户上传保存的

# ==============================================================================
# 4. 🐍 Python 运行时缓存
# ==============================================================================
# Python 会把 .py 文件编译成 .pyc 字节码文件缓存起来，下次运行更快，
# 但这些缓存是跟 Python 版本、操作系统绑定的，别人拿到也没用
__pycache__/
*.py[cod]        # 👈 匹配 .pyc / .pyo / .pyd
*.pyo
*.egg-info/
.pytest_cache/   # 👈 pytest 测试框架的缓存
.mypy_cache/     # 👈 mypy 类型检查的缓存
.ruff_cache/     # 👈 ruff 代码检查的缓存
.hypothesis/     # 👈 hypothesis 测试库的缓存

# ==============================================================================
# 5. 🌱 虚拟环境（Python 依赖包）
# ==============================================================================
# 虚拟环境里装了几十上百个第三方包（Pillow、Streamlit、loguru 等），
# 体积好几百 MB。协作时别人直接 pip install -r requirements.txt 就能装，
# 就像搬家时不需要把冰箱里的菜都搬走，到新家后重新买就行
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ==============================================================================
# 6. 🔧 IDE / 编辑器的本地配置
# ==============================================================================
# 这些是你本地 VS Code、PyCharm 等 IDE 的个性化设置，
# 比如字体、快捷键、断点位置等，跟别人不一样，不需要同步
.vscode/
.idea/
*.swp           # 👈 Vim 编辑器的临时交换文件
*.swo
*~

# ==============================================================================
# 7. 📝 Trae IDE 本地工作区（计划文档、会话记忆等）
# ==============================================================================
# .trae/ 是 Trae 本地生成的"工作区文件夹"，里面有功能计划、会话记录，
# 属于个人工作产物，不需要上传到仓库（如果团队想共享计划文档再单独挪）
.trae/

# ==============================================================================
# 8. 📜 日志文件
# ==============================================================================
# 程序运行时生成的日志，按天/次滚动，会越积越多
*.log
logs/

# ==============================================================================
# 9. 🧪 自测临时文件
# ==============================================================================
# 直接运行 python backend/image_generator.py 时会在项目根目录生成的测试图
test_card_*.png
test_*.png
test_*.jpg
test_*.jpeg
test_output*.png

# ==============================================================================
# 10. 🏗️ Python 打包 / 构建产物
# ==============================================================================
# 运行 python setup.py sdist / bdist_wheel 等打包命令生成的文件
dist/
build/
*.egg
eggs/
wheels/

# ==============================================================================
# 11. 💻 操作系统自动生成的垃圾文件
# ==============================================================================
# Windows / macOS 资源管理器自动生成的缩略图缓存、桌面属性等
.DS_Store          # 👈 macOS Finder 的文件夹元数据
Thumbs.db          # 👈 Windows 资源管理器的缩略图缓存
desktop.ini        # 👈 Windows 桌面/文件夹配置
ehthumbs.db        # 👈 Windows 媒体中心缩略图

# ==============================================================================
# 12. 🔤 字体文件（通常体积很大，按需下载）
# ==============================================================================
# 字体文件动辄几 MB 甚至几十 MB，不适合提交到 Git 仓库
# 需要时可以从原下载链接重新获取，或单独使用 LFS 管理
assets/fonts/*
# 👉 但以下几个项目运行必须的字体文件单独保留
!assets/fonts/LiuJianMaoCao-Regular.ttf
!assets/fonts/MaShanZheng-Regular.ttf
!assets/fonts/ZCOOLXiaoWei-Regular.ttf

# ==============================================================================
# 13. 🖼️ 大型素材图片（非代码依赖的可选资源）
# ==============================================================================
# 以下图片体积较大，按需提交，避免仓库臃肿
# 👉 注意：代码运行依赖的核心图片（如小精灵、背景图）会被 git 跟踪，不受此影响
# assets/backgrounds/ 已在上方单独处理

# ==============================================================================
# 14. 📂 保留空目录的占位文件（这个不忽略！）
# ==============================================================================
# .gitkeep 是一个约定俗成的空文件，唯一作用就是"让空目录能被 Git 跟踪"
# 因为 Git 本来不跟踪空目录，需要放个占位文件才能把目录结构提交上去
!.gitkeep
